    "license": "ISC",
    "scripts": {
        "start": "HFC_LOGGING1='{\"debug\":\"console\", \"info\":\"console\"}' CORE_CHAINCODE_LOGGING_LEVEL=DEBUG ts-node --transpile-only main.ts",
        "start:dev": "ts-node-dev --transpile-only main.ts",
        "build": "tsc",
        "typeorm": "ts-node ../../../../node_modules/typeorm/cli",
        "migration:run": "npm run typeorm migration:run -- -d ormconfig.migration.ts",
        "schema:drop": "ts-node --transpile-only schema-drop.ts",
        "reset": "npm run schema:drop && npm run migration:run"
    },
    "dependencies": {
        "@willsoto/nestjs-prometheus": "^6.0.2",
        "cache-manager-memory-store": "^1.1.0",
        "compression": "^1.7.4",
        "helmet": "^5.0.1",
        "pg": "^8.7.1",
        "prom-client": "^15.1.3"
    },
    "devDependencies": {
        "ts-node": "^10.4.0",
        "ts-node-dev": "^1.1.8",
        "tsconfig-paths": "^3.12.0",
        "typescript": "^4.5.5"
    }
}